a = 0
b = 0
c = 0
m = 0

while m != 10:
  print("Qual elevardor que você utiliza com mais frequência: ")
  print("1 - A")
  print("2 - B")
  print("3 - C")

  opc = int(input("Opção: "))

  if opc == 1:
    a += 1
    m += 1
  elif opc == 2:
    b += 1
    m += 1
  elif opc == 3:
    c += 1
    m += 1   
  else:
    print("Opção Invalida")

pa = (a * 100) / 10
pb = (b * 100) / 10
pc = (c * 100) / 10

print("Total A:", a,"Porcentagem:", pa)
print("Total B:", b,"Porcentagem:", pb)
print("Total C:", c,"Porcentagem:", pc)
