    jornal = int(input("Número: "))

    if jornal == "A":
        a += 1        
    elif jornal == "B":
        b += 1
    elif jornal == "C":
        c += 1

por_a = a * 20/100
por_b = b * 20/100
por_c = c * 20/100

if a < b and a < c:
    print("Jonal A:", por_a)
    if b < c:
        print("Jonal B:", por_b)
        print("Jonal C:", por_c)
    else:
        print("Jonal C:", por_c)
        print("Jonal B:", por_b)
elif b < a and b < c:
    print("Jonal B:", por_b)
    if a < c:
        print("Jonal A:", por_a)
        print("Jonal C:", por_c)
    else:
        print("Jonal C:", por_c)
        print("Jonal A:", por_a)
elif c < a and c < b:
    print("Jonal C:", por_c)
    if a < c:
        print("Jonal A:", por_a)
        print("Jonal B:", por_b)
    else:
