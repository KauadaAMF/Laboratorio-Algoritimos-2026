par = 0
im = 0
zero = 0

for i in range(1, 11):
    n = int(input("Numero: "))

    if n % 2 == 0:
        par += 1
    elif n % 2 == 1:
        im += 1
    elif n == 0:
        zero += 1

print("Quantidade de números pares:", par)
print("Quantidade de números ímpares: ", im)
print("Quantidade de zeros: ", zero)    
