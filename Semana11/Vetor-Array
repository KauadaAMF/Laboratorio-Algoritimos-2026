def main():
    elementos = []
    opc = 1
    while opc != 0:
        opc = menu()
        if opc == 1:
            elementos = inserir_elemento(elementos)
        elif opc == 2:
            listar_elementos(elementos)
        elif opc == 3:
            listar_linha(elementos)
        elif opc == 4:
            maior_elemento(elementos)
        elif opc == 5:
            menor_elemento(elementos)
        elif opc == 6:
            excluir_posição(elementos)
        elif opc == 7:
            elementos = excluir_valor(elementos)
        elif opc == 8:
