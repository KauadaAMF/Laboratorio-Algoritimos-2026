def menu():
    print("1 - Inserir Elemento")
    print("2 - Listar Elementos")
    print("3 - Listar Elemntos (Linha a Linha)")
    print("4 - Maior Elemento e sua Posição")
    print("5 - Menor Elemento e sua Posição")
    print("6 - Excluir Elemento por Posição")
    print("7 - Excluir Elemento por Valor")
    print("8 - Média dos Elementos")
    print("9 - Alterar Elemento")
    print("10 - Excluir Todos os Elementos")
    print("0 - Sair")
    opc = int(input("Digite a Opção"))
    return opc

def inserir_elemento(elementos):
    elemento = float(input("Digite um Elemento: "))
    elementos.append(elemento)
    return elementos

def listar_elementos(elementos):
    print("Elementos:")
    print(elementos)

def listar_linha(elementos):
    for i in range(len(elementos)):
        print("Posição: ", i , "Valor: ", elementos[i])
        #print("elementos[", i, "] = ", elementos[i])

def maior_elemento(elementos):
    if len(elementos) == 0:
        return
    maior = elementos[0]
    maior_pos = 0
    # maior = max(elementos) = Pega só o maior valor

    for i in range(len(elementos)):
        if maior > elementos[i]:
            maior = elementos[i]
            maior_pos = i

    print("Maior Elemento: ", maior)
    print("Posição: ", maior_pos)

def menor_elemento(elementos):
    if len(elementos) == 0:
        return
    menor = elementos[0]
    menor_pos = 0
    # menor = min(elementos) = Pega só o menor valor

    for i in range(len(elementos)):
        if menor > elementos[i]:
            menor = elementos[i]
            menor_pos = i

    print("Menor Elemento: ", menor)
    print("Posição: ", menor_pos)    

def excluir_posição(elementos):
    pos = int(input("Posição para Excluir: "))
    if pos >= 0 and pos < len(elementos):
        elementos.pop(pos)
    else:
        print("Posição não Encontrada")
    return elementos

def excluir_valor(elementos):
    valor = float(input("Valor para Excluir: "))
    if valor in elementos:
        elementos.remove(valor)
        print("Valor Excluido")
    else:
        print("Valor não Encontrado")
    return elementos

def media_elemetos(elementos):
    media = sum(elementos) / len(elementos)
    print("Média dos Elementos:", media)

def alterar_elemento(elementos):
    pos = int(input("Digite a Posição para Alterar o Elemento: "))
    if pos >= 0 and pos < len(elementos):
        novo_valor = float(input("Novo Valor: "))
        elementos[pos] = novo_valor
    else:
        print("Posição não Encontrada")
    return elementos

