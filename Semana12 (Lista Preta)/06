
def criar_IDs(IDs):
    import random
    
    for i in range(10):
        ID = random.randint(1, 50)
        IDs.append(ID)
    return IDs

def exibir(IDs):
    par = 0
    impar = 0
    
    for i in range(len(IDs)):
        if IDs[i] % 2 == 0:
            par += 1
        elif IDs[i] % 2 != 0:
            impar += 1
    
    print("Pares: ", par)
    print("Impares: ", impar)

def main():
    IDs = []
    IDs = criar_IDs(IDs)
    exibir(IDs)
    
main()
