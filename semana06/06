premiado = int(input("Numero Premiado: "))
exe = True
tentativas = 0

while exe:
    numero = int(input("Tente um numero: "))


    if numero == premiado:
        exe = False
    elif numero < premiado:
        print("Tente um número maior!")
    elif numero > premiado:
        print("Tente um número menor!")

print("Parabéns! Você encontrou a embalagem premiada!")
print("Tentativas Necessárias: ", tentativas)
