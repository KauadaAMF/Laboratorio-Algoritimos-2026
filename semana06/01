cont = 1
total = 0
maior = 0
menor = 0
dia_m = 0
dia_n = 0

while cont != 8:

    quilos = float(input("Quantidade de quilos de erva-mate produzidos: "))
    total += quilos


    if quilos > maior:
        maior = quilos
        dia_m = cont
    cont += 1

media = total / 7

print("Quantidade total produzida na semana: ", total)
print("O dia em que ocorreu a maior produção: ", dia_m)
print("O dia em que ocorreu a menor produção: ", dia_n)
print("Média diária de produção", media)
