pessoas = 0
soma = 0
maior = 0
menor = 0
todos_os_dias = 0

while pessoas != 20:
    vezes = int(input("Quantas vezes por semana você toma chimarrão: "))

    soma += vezes

    if pessoas == 0:
        maior = vezes
        menor = vezes
    else:
        if vezes > maior:
            maior = vezes

        if vezes < menor:
            menor = vezes

    if vezes >= 7:
        todos_os_dias += 1

media = soma / 20
