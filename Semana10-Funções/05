def res(media):
    if media >= 7:
        print("Aprovado")
    elif 4 <= media and media < 7:
        print("Recuperação")
    elif media < 4:
        print("Reprovado")

def cal_media():
    n1 = float(input("Nota 1: "))
    n2 = float(input("Nota 2: "))
    n3 = float(input("Nota 3: "))
    n4 = float(input("Nota 4: "))
    n5 = float(input("Nota 5: "))
    media = (n1 + n2 + n3 + n4 + n5) / 5
    return media
    
def main():
    media = cal_media()
    res(media)

main()
