
def ola():
    print("Valor:")
    print("Olá dentro da função")

def calcular_media(numero1, numero2):
    media = (numero1 + numero2) / 2
    print("Média:", media)

def calcular_media_return(numero1, numero2):
    media = (numero1 + numero2) / 2
    return media

def main():
    n1 = 5
    n2 = 9
    print("Dentro do Main")
    media_notas = calcular_media_return(n1, n2)
    print("Dentro do Main")

main()



def menu():
    print("1 - Sacar")
    print("2 - Depositar")
    print("3 - Saldo")
    print("4 - Sair")
    opc = int(input("Digite a Opção: "))
    return opc

def sacar(saldo):
    valor = float(input("Digite o valor para Sacar:"))
    if valor <= saldo:
        saldo = saldo - valor
        mostrar_saldo(saldo)
    else:
        print("Saldo Insuficiente")
    return saldo

def depositar(saldo):
    valor = float(input("Digite o valor para Depositar:"))
    if valor >= 0:
        saldo += valor
        mostrar_saldo(saldo)
    else:
        print("Valor Errado")
    return saldo

def mostrar_saldo(saldo):
    print("Saldo", saldo)

def main():
    saldo = 0
    opcao = 0

    while opcao != 4:
        opcao = menu()
        if opcao == 1:
            saldo = sacar(saldo)
        elif opcao == 2:
            saldo = depositar(saldo)
        elif opcao == 3:
            mostrar_saldo(saldo) 

main()
